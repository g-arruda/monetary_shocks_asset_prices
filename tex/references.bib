@article{alessi,
author = {Alessi, Lucia and Kerssenfischer, Mark},
title = {The response of asset prices to monetary policy shocks: Stronger than thought},
journal = {Journal of Applied Econometrics},
volume = {34},
number = {5},
pages = {661-672},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/jae.2706},
abstract = {Summary Standard macroeconomic theory predicts rapid responses of asset prices to monetary policy shocks. Small-scale vector autoregressions (VARs), however, often find sluggish and insignificant impact effects. Using the same high-frequency instrument to identify monetary policy shocks, we show that a large-scale dynamic factor model finds overall stronger and quicker asset price reactions compared to a benchmark VAR, both on euro area and US data. Our results suggest that incorporating a sufficiently large information set is crucial to estimate monetary policy effects.},
year = {2019}
}



